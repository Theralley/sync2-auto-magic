@@ -42,7 +42,9 @@
 {
     int cpu_flags = av_get_cpu_flags();
 
-    if (have_armv6(cpu_flags)) {
+    /* These load blk2 with plain "ldr", which may be unaligned; only safe where
+     * unaligned access is supported (not on Windows CE). */
