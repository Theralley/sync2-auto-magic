diff -ruN a/libavutil/log.c b/libavutil/log.c
--- a/libavutil/log.c	2016-05-03 04:10:09
+++ b/libavutil/log.c	2026-11-15 12:16:55
@@ -356,6 +356,12 @@
 void av_vlog(void* avcl, int level, const char *fmt, va_list vl)
 {
     void (*log_callback)(void*, int, const char*, va_list) = av_log_callback;
+#ifdef __MINGW32CE__
+    /* Windows CE (SYNC 2 AutoKit): logging is disabled, exactly as in the stock
+     * avutil-54.dll, whose av_vlog is a bare return. This keeps all console/stdio
+     * work (and the per-frame cost of decoder error messages) out of the decoder. */
+    return;
+#endif
     if (log_callback)
         log_callback(avcl, level, fmt, vl);
 }
