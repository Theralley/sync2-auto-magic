diff -ruN a/configure b/configure
--- a/configure	2016-05-03 04:10:04
+++ b/configure	2026-11-15 11:54:02
@@ -4098,8 +4098,12 @@
             LIBTARGET=arm-wince
         fi
         enabled shared && ! enabled small && check_cmd $windres --version && enable gnu_windres
-        check_ldflags -Wl,--nxcompat
-        check_ldflags -Wl,--dynamicbase
+        # Windows CE: keep DllCharacteristics 0 like the stock DLLs and every CE binary
+        # known to load on the target.
+        if test $target_os != "mingw32ce"; then
+            check_ldflags -Wl,--nxcompat
+            check_ldflags -Wl,--dynamicbase
+        fi
         enabled x86_32 && check_ldflags -Wl,--large-address-aware
         shlibdir_default="$bindir_default"
         SLIBPREF=""
@@ -4761,11 +4765,17 @@
 fi
 
 check_builtin atomic_cas_ptr atomic.h "void **ptr; void *oldval, *newval; atomic_cas_ptr(ptr, oldval, newval)"
+# Windows CE build is single-threaded (no pthreads/w32threads): keep libavutil's
+# plain fallback atomics like the stock DLLs instead of inlined LDREX/STREX/DMB.
+if test $target_os != "mingw32ce"; then
 check_builtin atomic_compare_exchange "" "int *ptr, *oldval; int newval; __atomic_compare_exchange_n(ptr, oldval, newval, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)"
+fi
 check_builtin machine_rw_barrier mbarrier.h "__machine_rw_barrier()"
 check_builtin MemoryBarrier windows.h "MemoryBarrier()"
 check_builtin sarestart signal.h "SA_RESTART"
+if test $target_os != "mingw32ce"; then
 check_builtin sync_val_compare_and_swap "" "int *ptr; int oldval, newval; __sync_val_compare_and_swap(ptr, oldval, newval)"
+fi
 
 check_func_headers malloc.h _aligned_malloc     && enable aligned_malloc
 check_func  ${malloc_prefix}memalign            && enable memalign
diff -ruN a/libavcodec/arm/cabac.h b/libavcodec/arm/cabac.h
--- a/libavcodec/arm/cabac.h	2016-03-29 04:25:10
+++ b/libavcodec/arm/cabac.h	2026-11-15 12:29:39
@@ -20,6 +20,12 @@
 #define AVCODEC_ARM_CABAC_H
 
 #include "config.h"
+/* Windows CE: the upstream refill read the next two bytestream bytes with one
+ * "ldrh" from c->bytestream, which is often at an odd address (an unaligned
+ * access; Windows CE may raise a datatype-misalignment exception for it). Without
+ * fast unaligned access the two bytes are loaded with two "ldrb" instead and
+ * combined as (p[0] << 9) | (p[1] << 1), exactly what "ldrh; rev; lsr #15"
+ * produced. Same bytes read, same result, no alignment requirement. */
 #if HAVE_ARMV6T2_INLINE
 
 #include "libavutil/attributes.h"
@@ -59,6 +65,7 @@
         "tst        %[r_c]        , %[r_c]                      \n\t"
         "bne        2f                                          \n\t"
         "ldr        %[r_c]        , [%[c], %[byte]]             \n\t"
+#if HAVE_FAST_UNALIGNED
 #if UNCHECKED_BITSTREAM_READER
         "ldrh       %[tmp]        , [%[r_c]]                    \n\t"
         "add        %[r_c]        , %[r_c]      , #2            \n\t"
@@ -77,6 +84,28 @@
         "rev        %[tmp]        , %[tmp]                      \n\t"
         "lsr        %[r_c]        , %[r_c]      , #15           \n\t"
         "lsr        %[tmp]        , %[tmp]      , #15           \n\t"
+#else /* alignment-safe refill: two byte loads, tmp = (p[0] << 9) | (p[1] << 1) */
+#if UNCHECKED_BITSTREAM_READER
+        "ldrb       %[tmp]        , [%[r_c]]                    \n\t"
+        "ldrb       %[r_b]        , [%[r_c], #1]                \n\t"
+        "add        %[r_c]        , %[r_c]      , #2            \n\t"
+        "str        %[r_c]        , [%[c], %[byte]]             \n\t"
+#else
+        "ldr        %[r_b]        , [%[c], %[end]]              \n\t"
+        "ldrb       %[tmp]        , [%[r_c]]                    \n\t"
+        "cmp        %[r_c]        , %[r_b]                      \n\t"
+        "ldrb       %[r_b]        , [%[r_c], #1]                \n\t"
+        "itt        lt                                          \n\t"
+        "addlt      %[r_c]        , %[r_c]      , #2            \n\t"
+        "strlt      %[r_c]        , [%[c], %[byte]]             \n\t"
+#endif
+        "orr        %[tmp]        , %[r_b]      , %[tmp], lsl #8\n\t"
+        "sub        %[r_c]        , %[low]      , #1            \n\t"
+        "add        %[r_b]        , %[tables]   , %[norm_off]   \n\t"
+        "eor        %[r_c]        , %[low]      , %[r_c]        \n\t"
+        "lsl        %[tmp]        , %[tmp]      , #1            \n\t"
+        "lsr        %[r_c]        , %[r_c]      , #15           \n\t"
+#endif
         "ldrb       %[r_c]        , [%[r_b], %[r_c]]            \n\t"
         "movw       %[r_b]        , #0xFFFF                     \n\t"
         "sub        %[tmp]        , %[tmp]      , %[r_b]        \n\t"
diff -ruN a/libavcodec/arm/me_cmp_init_arm.c b/libavcodec/arm/me_cmp_init_arm.c
